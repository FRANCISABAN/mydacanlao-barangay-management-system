PORT=5000

# XAMPP default: user "root", walang password, port 3306.
# Awtomatikong gagawin ang database kung wala pa.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mydacanlao

JWT_SECRET=palitan-ito-ng-mahaba-at-random-na-text
JWT_EXPIRES_IN=8h
# Frontend origin(s), separated by commas
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads

# Used only by `npm run seed`
SEED_USERNAME=secretary
SEED_PASSWORD=ChangeMe123!
SEED_BHW_USERNAME=bhw
SEED_BHW_PASSWORD=ChangeMe123!


SMTP_USER=johnriselermita@gmail.com
SMTP_PASS=nmun ovuj vbho ycye
# Optional. Mga port na susubukan, ayon sa pagkakasunod. Default: 465,587 (ang gumagana ang gagamitin).
# Huwag itong i-set sa isang port lang maliban kung kailangan.
# SMTP_PORT=465,587
# Email sa mga resident: gamit ang Gmail (walang domain na kailangan).
# 1) Sa Gmail account ng barangay: Google Account > Security > i-on ang 2-Step Verification
# 2) Pumunta sa myaccount.google.com/apppasswords > gumawa ng App password (16 letters)
# 3) Ilagay sa ibaba. Ang email ay ipapadala sa email na inilagay ng resident sa form.

# TEST MODE: kapag may laman, LAHAT ng email ay mapupunta sa address na ito sa halip na sa resident. Alisan ng laman sa totoong gamit.
EMAIL_REDIRECT_TO=
